{
  "name": "@smash-py-hub/web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.14.0 <23"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint . --max-warnings 0",

# Local-only development credentials. Never reuse them in production.
ENVIRONMENT=development
POSTGRES_DB=smashhub
POSTGRES_USER=smash_migrator
POSTGRES_PASSWORD=local_migration_only
APP_DB_USER=smash_app
APP_DB_PASSWORD=local_app_only
DATABASE_URL=postgresql+psycopg://smash_app:local_app_only@postgres:5432/smashhub
MIGRATION_DATABASE_URL=postgresql+psycopg://smash_migrator:local_migration_only@postgres:5432/smashhub
CORS_ORIGINS=["http://localhost:3000"]
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
WEB_PORT=3000
API_PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Optional, server-side only. Leave blank to disable real start.gg imports.
STARTGG_API_TOKEN=
# Background copy of start.gg into PostgreSQL (ADR-022). Needs the token above. The
# frequencies (STARTGG_SYNC_*_SECONDS) are documented in docs/operations/startgg-sync.md.
STARTGG_SYNC_ENABLED=false

# Legacy shared admin key (ADR-011), transition only (ADR-021). It works only while
# ADMIN_TOKEN_EXPIRES is set, has a time zone and is in the future (at most 90 days ahead).
# Leave both blank: administrators sign in with their own accounts.
ADMIN_TOKEN=
ADMIN_TOKEN_EXPIRES=

# Header where a trusted proxy puts the visitor's IP (App Platform: do-connecting-ip).
# Leave blank locally: without a proxy, no client-supplied header is trusted.
CLIENT_IP_HEADER=

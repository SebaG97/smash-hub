# Local-only development credentials. Never reuse them in production.
ENVIRONMENT=development
POSTGRES_DB=smashhub
POSTGRES_USER=smash_migrator
POSTGRES_PASSWORD=local_migration_only
APP_DB_USER=smash_app
APP_DB_PASSWORD=local_app_only
DATABASE_URL=postgresql+psycopg://smash_app:local_app_only@postgres:5432/smashhub
MIGRATION_DATABASE_URL=postgresql+psycopg://smash_migrator:local_migration_only@postgres:5432/smashhub
CORS_ORIGINS=["http://localhost:3000"]
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
WEB_PORT=3000
API_PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Optional, server-side only. Leave blank to disable real start.gg imports.
STARTGG_API_TOKEN=

# Optional, server-side only. Shared key for seeding edits (>= 24 chars); blank disables edits.
ADMIN_TOKEN=

# Optional, server-side only. Prode sign-in with start.gg (OAuth app at developer.start.gg).
# Blank disables sign-in. The redirect must match the one registered in start.gg.
STARTGG_OAUTH_CLIENT_ID=
STARTGG_OAUTH_CLIENT_SECRET=
STARTGG_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/startgg/callback
